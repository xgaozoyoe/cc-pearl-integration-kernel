+ assert sum(s.startswith('IMMA.') for s in rr.values())==64
+ (out/(name+'.diff')).write_text(''.join(difflib.unified_diff([f'{pc:04x} {s}\n' for pc,s in r.items()],[f'{pc:04x} {s}\n' for pc,s in rr.items()],fromfile='baseline',tofile=name)))
