+os.environ['CUDA_VISIBLE_DEVICES']='0'
+from pathlib import Path
+import ctypes as C,json,subprocess,sys,argparse,time,hashlib
+import numpy as np
+root=Path(__file__).resolve().parents[1];out=root/'artifacts/imma-cadence';sys.path.insert(0,str(root/'python'))
+p=argparse.ArgumentParser();p.add_argument('mode',choices=['validate','bench','profile']);p.add_argument('--variant',type=int,default=0,choices=range(3));args=p.parse_args()
+if args.mode!='profile':
+ uuid=subprocess.check_output(['nvidia-smi','-i','0','--query-gpu=uuid','--format=csv,noheader'],text=True).strip()
+ apps=subprocess.check_output(['nvidia-smi','--query-compute-apps=gpu_uuid','--format=csv,noheader'],text=True)
+ if uuid in apps:raise SystemExit('GPU0 is busy')
+import cuda_capi as cc
