+ asm volatile("{ .reg .b32 p,q;\n"
+              "lop3.b32 p,%1,%2,%3,0x96;\n"
+              "lop3.b32 q,%4,%5,%6,0x96;\n"
+              "lop3.b32 p,p,%7,%8,0x96;\n"
+              "xor.b32 %0,p,q; }"
+              : "=r"(x) : "r"(a[0]),"r"(a[1]),"r"(a[2]),"r"(a[3]),
+                           "r"(b[0]),"r"(b[1]),"r"(b[2]),"r"(b[3]));
+ return x;
 }
 
