+set -euo pipefail
+cd "$(dirname "$0")/.."
+if [[ $EUID -ne 0 ]]; then
+ echo 'Hardware counters require root: sudo bash tools/profile_handoff_cursor.sh' >&2
+ exit 1
+fi
+.venv/bin/python tools/check_gpu0_idle.py --allow-supervisor-pid "${1:-0}"
+export CUDA_VISIBLE_DEVICES=0
+export PEARL_IDLE_SUPERVISOR_PID="${1:-0}"
+
+PROFILE_OUT="${PROFILE_OUT:-$(mktemp -d /tmp/pearl-handoff-cursor.XXXXXX)}"
+printf '%s\n' "$PROFILE_OUT" > /tmp/pearl-handoff-cursor-last.txt
+chmod 644 /tmp/pearl-handoff-cursor-last.txt
