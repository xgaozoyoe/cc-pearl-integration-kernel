+    row=dict(variant=v,m=m,n=n,seed=seed,transcript_pass=True,digest_pass=True);results.append(row);print('PASS',row,flush=True)
+   for x in alloc:x.free()
+ Path('artifacts/handoff-cursor-correctness-small.json' if args.small_only else 'artifacts/handoff-cursor-correctness.json').write_text(json.dumps(results,indent=2)+'\n')
