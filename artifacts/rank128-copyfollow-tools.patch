+++ b/tests/bench_rank128_copyfinal.py
@@ -0,0 +1,85 @@
+"""GPU0-only full-A-tile fast path R128 test. Production library is never replaced."""
+import os
+os.environ['CUDA_VISIBLE_DEVICES']='0'
+import argparse,ctypes as C,json,re,statistics,sys
+from pathlib import Path
+import numpy as np
+root=Path(__file__).resolve().parents[1];sys.path.insert(0,str(root/'python'))
+import cuda_capi as cc
+import miner_capi as miner
+import pool_common
+P,I=C.c_void_p,C.c_int
+lib=C.CDLL(str(root/'artifacts/libpearl-rank128-copywalk-fulla-candidate.so'))
+lib.copyfollow_fulla_fold.argtypes=[I,P,P,I,I,P,P]
+lib.copyfollow_fulla_pow.argtypes=[I,P,P,I,I,P,P,P,P,P,P]
+ref=C.CDLL(str(root/'artifacts/libpearl-rank.so'))
+ref.rank_pow.argtypes=[I,P,P,I,I,P,P,P,P,P,P]
+def pow_call(v,a,b,m,n,key,target,t,d=None,f=None,c=None):
+ fn=ref.rank_pow if v==0 else lib.rank_pow
+ fn.argtypes=[I,P,P,I,I,P,P,P,P,P,P]
+ cc._chk(fn(128,cc._as(a),cc._as(b),m,n,cc._as(key),cc._as(target),cc._as(t),cc._as(d),cc._as(f),cc._as(c)),'copyfollow_fulla pow')
+p=argparse.ArgumentParser();p.add_argument('mode',choices=['validate','bench','profile']);p.add_argument('--variant',type=int,default=0);p.add_argument('--small-only',action='store_true');args=p.parse_args()
+resources={}
+for v in (0,1):
+ fn=ref.rank_fold if v==0 else lib.rank_fold
+ fn.argtypes=[I,P,P,I,I,P,P]
+ info=np.zeros(5,np.int32);cc._chk(fn(128,None,None,8192,8192,None,info.ctypes.data),'info');resources[v]=info.tolist()
+print('resources',resources,flush=True)
+if args.mode=='validate':
+ results=[]
+ for m,n in (((32,48),(256,384),(256,400)) if args.small_only else ((32,48),(256,384),(256,400),(8192,8192))):
+  for seed in (42,1234):
+   rng=np.random.default_rng(seed);alloc=[]
+   def buf(size):
+    x=cc.DBuf(size);alloc.append(x);return x
+   a,b=buf(m*4096),buf(n*4096);a.from_host(rng.integers(-128,128,(m,4096),np.int8));b.from_host(rng.integers(-128,128,(n,4096),np.int8))
+   key,target=buf(32),buf(32);key.from_host(rng.integers(0,256,32,np.uint8));target.memset(0)
+   t,d=buf(m*n//256*64),buf(m*n//256*32)
+   cc._chk(ref.rank_pow(128,a.ptr,b.ptr,m,n,key.ptr,target.ptr,t.ptr,d.ptr,None,None),'frozen')
+   expected_t=np.empty(m*n//256*16,np.uint32);expected_d=np.empty(m*n//256*32,np.uint8)
+   t.to_host(expected_t);d.to_host(expected_d)
+   for v in (0,1):
+    t.memset(0xa5);d.memset(0xa5);pow_call(v,a,b,m,n,key,target,t,d)
+    actual_t=np.empty_like(expected_t);actual_d=np.empty_like(expected_d);t.to_host(actual_t);d.to_host(actual_d)
+    assert np.array_equal(actual_t,expected_t),(v,m,n,seed,'transcript')
+    assert np.array_equal(actual_d,expected_d),(v,m,n,seed,'digest')
+    row=dict(variant=v,m=m,n=n,seed=seed,transcript_pass=True,digest_pass=True);results.append(row);print('PASS',row,flush=True)
+   for x in alloc:x.free()
+ Path('artifacts/rank128-copyfinal-correctness-small.json' if args.small_only else 'artifacts/rank128-copyfinal-correctness.json').write_text(json.dumps(results,indent=2)+'\n')
+elif args.mode=='profile':
+ a,b,t=cc.DBuf(8192*4096),cc.DBuf(8192*4096),cc.DBuf(512*512*64)
+ rng=np.random.default_rng(42)
+ for x in (a,b):x.from_host(rng.integers(-128,128,(8192,4096),np.int8))
+ for _ in range(40):
+  fn=ref.rank_fold if args.variant==0 else lib.rank_fold
+  fn.argtypes=[I,P,P,I,I,P,P]
+  cc._chk(fn(128,a.ptr,b.ptr,8192,8192,t.ptr,None),'profile');cc.sync()
+else:
+ assert resources[1][3]==1 and resources[1][4]==0,resources
+ miner.PROOF_PROCESS=False;miner.R=pool_common.R=128
+ class Pool:
+  def check_newer_job(self,job):return None
+ class Scheduler:
+  mode='user'
+  def __init__(self):self.grids=0
+  def note(self,elapsed):pass
+  def maybe_switch(self):self.grids+=1;return self.grids>=44
+ original_setup=cc.setup_job;results=[]
+ for repeat in range(2):
+  for v in ((0,1) if repeat==0 else (1,0)):
+   scheduler=Scheduler();times=[];bufs=miner.Bufs(8192)
+   cc.setup_job=lambda *a:original_setup(*a[:-1],202610070000+scheduler.grids)
+   cc.pearl_pow_split=lambda a,b,m,n,k,r,key,target,t,dig,found,coord,variant:pow_call(v,a,b,m,n,key,target,t,dig,found,coord)
+   def log(line):
+    match=re.search(r'grid wall: ([\d.]+) s',line)
+    if match:times.append(float(match[1])*1000)
+   miner.mine_job(Pool(),pool_common.real_config(),bytes(80),0,'offline',8192,0,scheduler,bufs,dict(user=0,dev=0),None,log)
+   values=times[4:];mean=statistics.mean(values)
+   row=dict(variant=v,repeat=repeat,samples=len(values),median_ms=statistics.median(values),mean_ms=mean,p95_ms=float(np.percentile(values,95)),grids_sec=1000/mean,consensus_equivalent_ths=(2**46/1e12)*1000/mean)
+   row["samples_ms"]=values;results.append(row);print(json.dumps({k:x for k,x in row.items() if k!="samples_ms"}),flush=True)
+   for value in vars(bufs).values():
+    if isinstance(value,cc.DBuf):value.free()
+    elif isinstance(value,list):
+     for x in value:
+      if isinstance(x,cc.DBuf):x.free()
+ Path('artifacts/rank128-copyfinal-results.json').write_text(json.dumps(dict(resources=resources,measurements=results),indent=2)+'\n')
diff --git a/tools/run_copywalk_metrics.py b/tools/run_copywalk_metrics.py
new file mode 100644
index 0000000..886f2dc
--- /dev/null
+++ b/tools/run_copywalk_metrics.py
@@ -0,0 +1,29 @@
+"""Offline full-grid load for external Tensor Active metrics. GPU0 only."""
+import os
+os.environ['CUDA_VISIBLE_DEVICES']='0'
+import argparse,ctypes as C,time,sys,json
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+p=argparse.ArgumentParser();p.add_argument('--library',type=Path,required=True);args=p.parse_args()
+sys.path.insert(0,str(root/'python'))
+import cuda_capi as cc
+import miner_capi as miner
+import pool_common
+lib=C.CDLL(str(args.library.resolve()));lib.rank_pow.argtypes=[C.c_int,C.c_void_p,C.c_void_p,C.c_int,C.c_int]+[C.c_void_p]*6
+miner.PROOF_PROCESS=False;miner.R=pool_common.R=128
+class Pool:
+ def check_newer_job(self,job):return None
+class Scheduler:
+ mode='user'
+ def __init__(self):self.grids=0;self.start=time.perf_counter()
+ def note(self,elapsed):pass
+ def maybe_switch(self):self.grids+=1;return time.perf_counter()-self.start>=42
+scheduler=Scheduler();setup=cc.setup_job
+cc.setup_job=lambda *a:setup(*a[:-1],202610070000+scheduler.grids)
+def pow_call(a,b,m,n,k,r,key,target,t,d,found,coord,variant):
+ assert k==4096 and r==128
+ cc._chk(lib.rank_pow(r,cc._as(a),cc._as(b),m,n,cc._as(key),cc._as(target),cc._as(t),cc._as(d),cc._as(found),cc._as(coord)),'rank_pow')
+cc.pearl_pow_split=pow_call
+bufs=miner.Bufs(8192)
+miner.mine_job(Pool(),pool_common.real_config(),bytes(80),0,'offline-metrics',8192,0,scheduler,bufs,dict(user=0,dev=0),None,lambda x:print(x,flush=True))
+print(json.dumps(dict(grids=scheduler.grids,seconds=time.perf_counter()-scheduler.start,library=str(args.library))))
