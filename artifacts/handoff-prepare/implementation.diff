+ (out/(name+'.cubin')).write_bytes(blob)
+ manifest['variants'][name]={'entry':entry,'sha256':hashlib.sha256(blob).hexdigest(),'smem':69632,'correct':True}
+(out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
